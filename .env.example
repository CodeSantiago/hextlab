# Agent Host (backend)
HOST_PORT=8000
HOST_PUBLIC_URL=http://localhost:8000

# Browser origins allowed to call the management API.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Optional: where providers.json lives. Defaults to <repo>/.data
# PLAYGROUND_DATA_DIR=.data

# LLM request limits
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=1024
